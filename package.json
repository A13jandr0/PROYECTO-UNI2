{
  "name": "backend-uni2",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:controllers": "jest tests/controllers/",
    "test:auth": "jest tests/controllers/auth.test.js",
    "test:eventos": "jest tests/controllers/eventos.test.js",
    "test:megaeventos": "jest tests/controllers/megaEventos.test.js"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "models/**/*.js",
      "!node_modules/",
      "!coverage/",
      "!server.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "verbose": true,
    "collectCoverage": false,
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 10000
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-node": "^30.0.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.0.1",
    "sinon": "^20.0.0",
    "supertest": "^6.3.4"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "sqlserver",
    "authentication",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "mssql": "^11.0.1",
    "multer": "^2.0.0",
    "nodemon": "^3.1.9",
    "resend": "^2.1.0",
    "sharp": "^0.34.2",
    "validator": "^13.11.0"
  }
}
